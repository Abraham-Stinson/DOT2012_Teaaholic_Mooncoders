  npcSpawnDataList:
  - npcPrefab: {fileID: 2284876664122768610, guid: 2c61c08250e90be49850fe7e80812514, type: 3}
    npcName: "Yabanc\u0131"
    spawnDay: 5
    minSpawnHour: 9
    maxSpawnHour: 10
    dialogueData:
    - npcQuote: "Selam\u0131naleyk\xFCm garda\u015F."
      playerOptions:
      - text: "Aleyk\xFCmselam. Buyurun. "
        wearEffect: -2
        moneyEffect: 0
        nextDialogueIndex: 1
      - text: Selam
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: 1
      - text: "Merhaba. Ne vard\u0131?"
        wearEffect: 2
        moneyEffect: 0
        nextDialogueIndex: 1
    - npcQuote: "Ben ve bir ka\xE7 arkada\u015F\u0131m grev yap\u0131yoruz. Evden
        at\u0131ld\u0131k. Bu gecelik Burada kalabilir miyiz? "
      playerOptions:
      - text: "Nerde \xE7al\u0131\u015F\u0131yorsunuz, niye evden at\u0131ld\u0131n\u0131z?
          \u015Eu olay\u0131n asl\u0131n\u0131 astar\u0131n\u0131 bir anlat. "
        wearEffect: -2
        moneyEffect: 0
        nextDialogueIndex: 2
      - text: "\u015Eu olay\u0131n tamam\u0131n\u0131 anlat bakal\u0131m. "
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: 2
      - text: "\xD6yle mi olmu\u015F!?"
        wearEffect: 2
        moneyEffect: 0
        nextDialogueIndex: 2
    - npcQuote: "Garda\u015F biz devletin \u015Feker fabrikas\u0131nda \xE7al\u0131\u015F\u0131yoruz.
        Bizim k\xF6r olas\u0131ca bir m\xFCd\xFCr var. Bu m\xFCd\xFCr bizi sebepsiz
        yere i\u015Ften \xE7\u0131kard\u0131\u011F\u0131 yetmezmi\u015F gibi \xFCst\xFCne
        bir de bizim yerimize akrabalar\u0131n\u0131 i\u015Fe soktu."
      playerOptions:
      - text: "Garda\u015F \u015Fikayet etmediniz mi? "
        wearEffect: -2
        moneyEffect: 0
        nextDialogueIndex: 3
      - text: "E sizde gidip \u015Fikayet etseydiniz adam\u0131. "
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: 3
      - text: "Git polise \u015Fikayet et."
        wearEffect: 2
        moneyEffect: 0
        nextDialogueIndex: 3
    - npcQuote: "\u015Eikayet etmez olur muyuz. Ettik \u015Fikayet ama m\xFCd\xFCr\xFCn
        \xFCst r\xFCtbelilerden tan\u0131d\u0131klar\u0131 varm\u0131\u015F. \u015Eikayet
        etti\u011Fimizle kald\u0131k."
      playerOptions:
      - text: "B\xF6yle sistemin \xE7ark\u0131na t\xFCk\xFCreyim. Evden niye at\u0131ld\u0131n\u0131z
          ya? "
        wearEffect: -2
        moneyEffect: 0
        nextDialogueIndex: 4
      - text: "Evden niye at\u0131ld\u0131n\u0131z? "
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: 4
      - text: "Evden at\u0131lma hikayen ne!? "
        wearEffect: 2
        moneyEffect: 0
        nextDialogueIndex: 4
    - npcQuote: "Hah i\u015Fte. Evin sahibi de bizim m\xFCd\xFCr. Zaman\u0131nda
        ucuzdan verdi bize evi. Paray\u0131 da elden istiyordu. Bizi kap\u0131 d\u0131\u015F\u0131na
        att\u0131\u011F\u0131nda anlad\u0131k vergi falan \xF6demiyormu\u015F. Biz
        de halka sesimizi duyural\u0131m bari diye grev yapmaya karar verdik ama
        derdimizi dinleyen bir sen vars\u0131n."
      playerOptions:
      - text: "Ge\xE7mi\u015F olsun. Vallaha \xE7ok \xFCz\xFCld\xFCm. "
        wearEffect: -2
        moneyEffect: 0
        nextDialogueIndex: 5
      - text: "Ge\xE7mi\u015F olsun. "
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: 5
      - text: "Ald\u0131n kar\u015F\u0131na beni. Zorla anlat\u0131yon."
        wearEffect: 2
        moneyEffect: 0
        nextDialogueIndex: 5
    - npcQuote: "Eyvallah garda\u015F. D\xFCkkan\u0131n m\xFCsaitse 1 2 g\xFCn burada
        kalabilir miyiz? "
      playerOptions:
      - text: "Tabi ki, kalabilirsiniz. \u015Eu paray\u0131da al\u0131n bir \u015Feyler
          yersiniz."
        wearEffect: -25
        moneyEffect: -200
        nextDialogueIndex: 6
      - text: "Gidin benim ba\u015F\u0131m\u0131 belaya sokmay\u0131n. E\u015Fim
          \xE7ocu\u011Fum var benim."
        wearEffect: 25
        moneyEffect: 0
        nextDialogueIndex: 7
    - npcQuote: "Eyvallah garda\u015F. Gece kal\u0131r\u0131z g\xF6r\xFCnmeyiz bile
        sana."
      playerOptions:
      - text: "\u0130yi geceler"
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: -1
    - npcQuote: "Eyvallah garda\u015F. Sende hakl\u0131s\u0131n."
      playerOptions:
      - text: "\u0130yi geceler"
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: -1
  - npcPrefab: {fileID: 2964728432240494246, guid: 46b27bd0ccc515940a5d145ac4cc66cc, type: 3}
    npcName: "Topuk\xE7u Naz\u0131m"
    spawnDay: 1
    minSpawnHour: 9
    maxSpawnHour: 10
    dialogueData:
    - npcQuote: "Ahmet abi, hi\xE7 g\xF6r\xFC\u015Femiyoruz."
      playerOptions:
      - text: "Senin ne i\u015Fin var burada!? Art\u0131k sizinle \xE7al\u0131\u015Fm\u0131yorum."
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: 1
    - npcQuote: "\u015E\u015F\u015F\u015F\u2026 Sessiz ol. Bu i\u015Flerden ancak
        \xF6l\xFCnce ayr\u0131l\u0131rs\u0131n."
      playerOptions:
      - text: Niye geldin buraya?
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: 2
    - npcQuote: "Bak. Polis pe\u015Fimde sana bir dosya verece\u011Fim. Bunu saklarsan
        cebini de doldururum."
      playerOptions:
      - text: "\u0130stemiyorum karde\u015Fim. Zorla m\u0131 vereceksin."
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: 3
    - npcQuote: "Ahmet k\u0131z\u0131n okuldan sa\u011F salim d\xF6ns\xFCn istiyorsan
        \xE7ok sesini \xE7\u0131karma. Al \u015Fu dosyay\u0131. Hem kar\u0131n\u0131n
        ameliyat paras\u0131n\u0131n bir k\u0131sm\u0131n\u0131 da \xE7\u0131kar\u0131rs\u0131n
        b\xF6ylece."
      playerOptions:
      - text: "Tamam. Ver \u015Fu dosyay\u0131."
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: 4
    - npcQuote: "Hah \u015F\xF6yle. Bak e\u011Fer polis falan u\u011Frarsa sana dosya
        vermedim. Hatta buraya bile gelmedim."
      playerOptions:
      - text: Tamam.
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: -1
  - npcPrefab: {fileID: 2964728432240494246, guid: 46b27bd0ccc515940a5d145ac4cc66cc, type: 3}
    npcName: Polis
    spawnDay: 1
    minSpawnHour: 9
    maxSpawnHour: 10
    dialogueData:
    - npcQuote: Merhabalar beyefendi.
      playerOptions:
      - text: "Merhabalar memur bey nas\u0131l yard\u0131mc\u0131 olabilirim."
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: 1
    - npcQuote: "Son g\xFCnlerde buralarda hi\xE7 tekinsiz tipler g\xF6rd\xFCn m\xFC?"
      playerOptions:
      - text: "Yok hi\xE7 g\xF6rmedim."
        wearEffect: 2
        moneyEffect: 0
        nextDialogueIndex: 2
      - text: Buralarda herkes tekinsizdir.
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: 2
      - text: "Asl\u0131nda evet birini g\xF6rd\xFCm. \u0130ki g\xFCn \xF6nceydi.
          Bir adam geldi, beni k\u0131z\u0131m\u0131n can\u0131yla tehdit etti. Daha
          sonra bana bu belgeleri verdi."
        wearEffect: -2
        moneyEffect: 0
        nextDialogueIndex: 12
    - npcQuote: Emin misiniz?
      playerOptions:
      - text: "Evet. Neden bir olay m\u0131 oldu?"
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: 3
    - npcQuote: "Bir ihbar ald\u0131k onu soru\u015Fturuyoruz. Ama sen e\u011Fer
        buralarda siyah giyen kap\xFC\u015Fonlu birileri sana gelip dosya falan vermeye
        \xE7al\u0131\u015F\u0131rsa bunu ihbar ederdin de\u011Fil mi?"
      playerOptions:
      - text: Tabi ki Memur Bey
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: 4
    - npcQuote: "Bak e\u011Fer b\xF6yle bir olay olduysa \u015E\u0130MD\u0130 konu\u015F.
        \xC7\xFCnk\xFC biz yakalarsak bunun b\xFCy\xFCk cezas\u0131 var."
      playerOptions:
      - text: "B\xF6yle bir olay olmad\u0131 memur bey."
        wearEffect: 30
        moneyEffect: 0
        nextDialogueIndex: 5
      - text: "Asl\u0131nda san\u0131r\u0131m oldu."
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: 6
      - text: Oldu memur bey ama...
        wearEffect: -5
        moneyEffect: 0
        nextDialogueIndex: 7
    - npcQuote: "Yalan s\xF6yledi\u011Fini biliyorum. Sana 5 bin lira ceza yazaca\u011F\u0131m
        \u015Fimdi."
      playerOptions:
      - text: "Yaz\u0131n memur bey. Hak ettim."
        wearEffect: -10
        moneyEffect: -5000
        nextDialogueIndex: 9
      - text: "Memur bey \u015Furadan 1500 al\u0131n. Beni g\xF6rmeyin."
        wearEffect: 10
        moneyEffect: -1500
        nextDialogueIndex: 10
      - text: "Memur bey kap\u0131ya 2000 s\u0131k\u0131\u015Fm\u0131\u015F sizin
          mi acaba?"
        wearEffect: 15
        moneyEffect: -2000
        nextDialogueIndex: 10
    - npcQuote: "San\u0131r\u0131m oldu mu? Dalga m\u0131 ge\xE7iyorsun lan benle. "
      playerOptions:
      - text: Memur bey tehdit edildim.
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: 8
    - npcQuote: AMA NE!? NE AMA!?
      playerOptions:
      - text: Memur bey tehdit edildim.
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: 8
    - npcQuote: "Az \xF6nce korkuyordun \u015Fimdi korkmuyor musun? Sana en az 5
        bin lira ceza yazaca\u011F\u0131m \u015Fimdi."
      playerOptions:
      - text: "Yaz\u0131n memur bey. Hak ettim."
        wearEffect: -10
        moneyEffect: -5000
        nextDialogueIndex: 9
      - text: "Memur bey \u015Furadan 1500 al\u0131n. Beni g\xF6rmeyin."
        wearEffect: 10
        moneyEffect: -1500
        nextDialogueIndex: 10
      - text: "Memur bey kap\u0131ya 2000 s\u0131k\u0131\u015Fm\u0131\u015F sizin
          mi acaba?"
        wearEffect: 15
        moneyEffect: -2000
        nextDialogueIndex: 10
    - npcQuote: "Ver bakal\u0131m \u015Fu dosyalar\u0131."
      playerOptions:
      - text: "Buyurun. \u0130yi ak\u015Famlar. "
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: -1
    - npcQuote: "Ulan sen devletin memuruna r\xFC\u015Fvet mi teklif ediyorsun?"
      playerOptions:
      - text: "Hay\u0131r memur bey olur mu \xF6yle \u015Fey. Yerde biraz para buldum
          belki sizindir diye sordum."
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: 11
    - npcQuote: "Haaa\u2026 Bakay\u0131m... Benim yav bunlar. Bu paray\u0131 ve dosyay\u0131
        al\u0131yorum. Sana ceza yazmayaca\u011F\u0131m."
      playerOptions:
      - text: "\u0130yi ak\u015Famlar."
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: -1
    - npcQuote: "\u015Eimdi sana 2000 lira ceza yazmak zorunday\u0131m."
      playerOptions:
      - text: Tabi ki memur bey hak ettim.
        wearEffect: -15
        moneyEffect: -2000
        nextDialogueIndex: 9
      - text: "Memur bey \u015Furadan 750 lira al\u0131n. Beni g\xF6rmeyin."
        wearEffect: 10
        moneyEffect: -750
        nextDialogueIndex: 10
      - text: "Memur bey kap\u0131ya 1000 lira s\u0131k\u0131\u015Fm\u0131\u015F
          sizin mi acaba?"
        wearEffect: 15
        moneyEffect: -1000
        nextDialogueIndex: 10
  - npcPrefab: {fileID: 2964728432240494246, guid: 46b27bd0ccc515940a5d145ac4cc66cc, type: 3}
    npcName: "Topuk\xE7u Naz\u0131m"
    spawnDay: 1
    minSpawnHour: 9
    maxSpawnHour: 10
    dialogueData:
    - npcQuote: Dosyalar nerede?
      playerOptions:
      - text: "Dosyalar\u0131 polise kapt\u0131rd\u0131m."
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: 1
    - npcQuote: "Seni bo\u015Funa m\u0131 tehdit ettim san\u0131yosun?"
      playerOptions:
      - text: "K\u0131z\u0131m\u0131n k\u0131l\u0131na dokunay\u0131m deme."
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: -1
  - npcPrefab: {fileID: 2964728432240494246, guid: 46b27bd0ccc515940a5d145ac4cc66cc, type: 3}
    npcName: "Yabanc\u0131"
    spawnDay: 1
    minSpawnHour: 9
    maxSpawnHour: 10
    dialogueData:
    - npcQuote: "Merhaba. Sizi rahats\u0131z etti\u011Fim i\xE7in \xF6z\xFCr dilerim."
      playerOptions:
      - text: "Esta\u011Ffurullah ne rahats\u0131zl\u0131\u011F\u0131. Bir \u015Fey
          mi istemi\u015Ftiniz?"
        wearEffect: -5
        moneyEffect: 0
        nextDialogueIndex: 1
      - text: "Merhaba, ne istemi\u015Ftin?"
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: 1
      - text: Ne var, ne istiyorsun?
        wearEffect: 5
        moneyEffect: 0
        nextDialogueIndex: 1
    - npcQuote: "\u015Eey... Yan\u0131ma para almay\u0131 unutmu\u015Fum da... Paras\u0131z
        kalabilece\u011Fim bir yer gerekiyor."
      playerOptions:
      - text: "\u0130sterseniz bizim evde misafir edelim sizi? Ben de \u015Fimdi
          \xE7\u0131k\u0131yordum."
        wearEffect: -15
        moneyEffect: 0
        nextDialogueIndex: 2
      - text: "\u0130ki sokak \xF6tede bir cami var oraya sor."
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: 7
      - text: "Paran yoksa evine git bac\u0131m."
        wearEffect: 35
        moneyEffect: 0
        nextDialogueIndex: 6
    - npcQuote: "Size rahats\u0131zl\u0131k vermeyeyim."
      playerOptions:
      - text: "Yok can\u0131m ne rahats\u0131zl\u0131\u011F\u0131 vereceksiniz."
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: 3
    - npcQuote: "Ben de\u011Fil de... Kocam... Kocam benim pe\u015Fimde."
      playerOptions:
      - text: "Kavga m\u0131 ettiniz?"
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: 4
    - npcQuote: "(G\xF6zl\xFC\u011F\xFCn\xFC \xE7\u0131kar\u0131r. G\xF6z\xFC morarm\u0131\u015Ft\u0131r.)"
      playerOptions:
      - text: "Gelin benimle saat ge\xE7 oldu."
        wearEffect: -20
        moneyEffect: 0
        nextDialogueIndex: 5
      - text: "Han\u0131mefendi benim ba\u015F\u0131m\u0131 belaya sokmay\u0131n."
        wearEffect: 15
        moneyEffect: 0
        nextDialogueIndex: 6
    - npcQuote: "Te\u015Fekk\xFCrler."
      playerOptions:
      - text: "\xD6nemli de\u011Fil."
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: 1
    - npcQuote: "Siz de hakl\u0131s\u0131n\u0131z. \u0130yi ak\u015Famlar."
      playerOptions:
      - text: "\u0130yi ak\u015Famlar."
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: 1
    - npcQuote: Camide beni kesin bulur.
      playerOptions:
      - text: 'Kim bulur? '
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: 8
    - npcQuote: Kocam.
      playerOptions:
      - text: "Neden ka\xE7\u0131yorsunuz ki, kavga m\u0131 ettiniz?"
        wearEffect: 0
        moneyEffect: 0
        nextDialogueIndex: 4
